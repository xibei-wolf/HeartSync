# ==========================================================================
# 心晴校园 HeartSync —— 后端服务大模型配置
# ==========================================================================
# 用法：把本文件重命名为 .env，填入自己的 API Key，然后双击 start.bat 启动。
#
# 安全提示：
#   .env 已被 .gitignore 排除，不会被提交到 Gitee 等代码托管平台。
#   若要分享源码给别人，请只分享 .env.example，不要分享填好 Key 的 .env。
# ==========================================================================

# 大模型 API Key（必填；留空则服务端进入离线兜底模式，App 依然可完整演示）
AI_API_KEY=

# 接口地址：所有 OpenAI 兼容的服务商只需改这里 + 模型名
#   通义千问  https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
#   DeepSeek  https://api.deepseek.com/v1                          deepseek-chat
#   智谱 GLM  https://open.bigmodel.cn/api/paas/v4                 glm-4-flash
#   月之暗面  https://api.moonshot.cn/v1                            moonshot-v1-8k
AI_API_BASE=https://api.deepseek.com/v1

# 模型名
AI_MODEL=deepseek-chat

# 服务端口（默认 8080）
PORT=8080
