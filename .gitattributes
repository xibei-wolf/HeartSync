# 统一换行符：仓库内一律用 LF，避免 Windows/macOS 混用产生无意义的整文件差异
* text=auto eol=lf

# Windows 批处理与 PowerShell 脚本必须保持 CRLF，否则无法执行
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.ico binary
*.jar binary
*.apk binary
*.mp4 binary

# Gradle wrapper 是二进制
gradle/wrapper/gradle-wrapper.jar binary
