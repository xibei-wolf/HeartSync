<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 心情分值 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CardBase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/TextH3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mood_score" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <RatingBar
                        android:id="@+id/rbMoodScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:rating="3"
                        android:stepSize="1" />

                    <TextView
                        android:id="@+id/tvMoodText"
                        style="@style/TextH3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="一般"
                        android:textColor="@color/mood_normal" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 情绪标签 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CardBase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/TextH3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mood_select_tag" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cgMoodTags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:singleLine="false"
                    app:singleSelection="false">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTag0"
                        style="@style/ChipTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="开心" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTag1"
                        style="@style/ChipTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="平静" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTag2"
                        style="@style/ChipTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="充实" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTag3"
                        style="@style/ChipTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="疲惫" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTag4"
                        style="@style/ChipTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="焦虑" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTag5"
                        style="@style/ChipTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="低落" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTag6"
                        style="@style/ChipTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="烦躁" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTag7"
                        style="@style/ChipTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="紧张" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTag8"
                        style="@style/ChipTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="孤独" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTag9"
                        style="@style/ChipTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="被理解" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTag10"
                        style="@style/ChipTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="有动力" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTag11"
                        style="@style/ChipTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="迷茫" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 日记 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CardBase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDiary"
                    style="@style/InputOutlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/mood_diary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDiary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:hint="@string/mood_diary_hint"
                        android:inputType="textMultiLine"
                        android:minLines="4" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/BtnPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/common_save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            style="@style/BtnOutline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/common_delete"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
