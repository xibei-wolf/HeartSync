<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 运动类型 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CardBase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/TextH3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/exercise_type" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cgExerciseType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:singleLine="false"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipType0"
                        style="@style/ChipTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="跑步" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipType1"
                        style="@style/ChipTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="快走" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipType2"
                        style="@style/ChipTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="骑行" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipType3"
                        style="@style/ChipTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="游泳" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipType4"
                        style="@style/ChipTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="篮球" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipType5"
                        style="@style/ChipTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="羽毛球" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipType6"
                        style="@style/ChipTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="足球" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipType7"
                        style="@style/ChipTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="瑜伽" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipType8"
                        style="@style/ChipTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="健身训练" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipType9"
                        style="@style/ChipTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="跳绳" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipType10"
                        style="@style/ChipTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="拉伸放松" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipType11"
                        style="@style/ChipTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="其他" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 时长 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CardBase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/TextH3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/exercise_duration" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDuration"
                    style="@style/InputOutlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/exercise_duration">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDuration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/exercise_duration"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 强度 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CardBase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/TextH3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/exercise_intensity" />

                <RadioGroup
                    android:id="@+id/rgIntensity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbIntensity1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="轻松"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbIntensity2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:checked="true"
                        android:text="适中"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbIntensity3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="高强度"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 消耗热量 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CardBase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/TextH3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/exercise_calories" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCalories"
                    style="@style/InputOutlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/exercise_calories">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCalories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/exercise_calories"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 备注 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CardBase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/TextH3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/exercise_note" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNote"
                    style="@style/InputOutlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/exercise_note">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:hint="@string/exercise_note"
                        android:inputType="textMultiLine"
                        android:minLines="2" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvEstimate"
            style="@style/TextCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="留空将根据运动类型与时长自动估算消耗热量"
            android:textColor="@color/brand_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/BtnPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/common_save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            style="@style/BtnOutline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/common_delete"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
