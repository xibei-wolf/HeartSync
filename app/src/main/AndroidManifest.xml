<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.HeartSync">

        <!-- 启动页 -->
        <activity
            android:name=".activity.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.HeartSync.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 登录 / 注册 -->
        <activity android:name=".activity.LoginActivity" android:exported="false" />

        <!-- 主界面（底部导航 + 5 个 Fragment） -->
        <activity android:name=".activity.MainActivity" android:exported="false" />

        <!-- 作息模块 -->
        <activity android:name=".activity.SleepActivity" android:exported="false" />
        <activity android:name=".activity.SleepDetailActivity" android:exported="false" />

        <!-- 运动模块 -->
        <activity android:name=".activity.ExerciseActivity" android:exported="false" />

        <!-- 情绪模块 -->
        <activity android:name=".activity.MoodActivity" android:exported="false" />
        <activity android:name=".activity.MoodDetailActivity" android:exported="false" />

        <!-- 大模型 AI 模块 -->
        <activity android:name=".activity.AiChatActivity" android:exported="false" />

        <!-- 校园急救模块 -->
        <activity android:name=".activity.FirstAidActivity" android:exported="false" />
        <activity android:name=".activity.FirstAidDetailActivity" android:exported="false" />

        <!-- 健康报告 -->
        <activity android:name=".activity.HealthReportActivity" android:exported="false" />

        <!-- 设置 -->
        <activity android:name=".activity.SettingsActivity" android:exported="false" />

    </application>

</manifest>
